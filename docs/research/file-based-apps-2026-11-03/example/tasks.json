{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build file-based app for netcoredbg",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/app.cs",
        "--configuration",
        "Debug",
        "--output",
        "${workspaceFolder}/.file-based-debug/app"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
